# Firebase Web App configuration (public client configuration)
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

# Optional: Google Maps browser key
VITE_GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-key

# Stripe test mode — secret values belong only in .env.local or the server environment.
# Never expose STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET as VITE_ variables.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_WEBHOOK_PORT=8787
FIREBASE_SERVICE_ACCOUNT_JSON={"client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"}
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key

# Optional public Stripe key for a browser checkout integration.
# A real checkout session must still be created by the server with STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
